<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/getting-started</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/ecosystem</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/skills</loc>
    <changefreq>monthly</changefreq>
    <priority>0.65</priority>
  </url>
  <%= for pkg <- @ecosystem_packages do %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/ecosystem/<%= pkg.id %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/examples</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <%= for example <- @examples do %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/examples/<%= example.slug %></loc>
    <%= if modification_date = AgentJido.Examples.modification_date(example), do: "<lastmod>#{modification_date}</lastmod>" %>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/features</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/community</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/community/showcase</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/blog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <%= for post <- @blog_posts, !Map.get(post.seo || %{}, :noindex, false) do %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %>/blog/<%= post.id %></loc>
    <lastmod><%= Date.to_iso8601(post.date) %></lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <%= for page <- @pages, !Map.get(page.seo || %{}, :noindex, false) do %>
  <url>
    <loc><%= AgentJidoWeb.Endpoint.url() %><%= AgentJido.Pages.route_for(page) %></loc>
    <%= if modification_date = AgentJido.Pages.modification_date(page), do: "<lastmod>#{modification_date}</lastmod>" %>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
</urlset>
